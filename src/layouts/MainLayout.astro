---
import Header from '@src/components/Header.astro';
import Footer from '@src/components/Footer.astro';
import SchemaMarkup from '@src/components/SchemaMarkup.astro';
import { Font } from "astro:assets";

import 'glightbox/dist/css/glightbox.min.css';
import '@src/styles/style.css';
import BackToTop from '@src/components/BackToTop.astro';
import ExitPopup from '@src/components/ExitPopup.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  schema?: object;
}

const {
  title = "El Hostalet de Tossa & El Bergantí",
  description = "Disfruta de la auténtica Costa Brava. Dos alojamientos con encanto en el centro de Tossa de Mar con restaurante y reserva directa.",
  image = "/images/tossa-de-mar-costa-brava-1.webp",
  type = "website",
  schema
} = Astro.props;

const lang = Astro.currentLocale || 'es';
const siteUrl = Astro.url?.href || "https://alojamientotossademar.com";
// Ensure absolute URL for OpenGraph images
const ogImage = image.startsWith('http') ? image : `https://alojamientotossademar.com${image}`;

---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Primary Meta -->
    <meta name="description" content={description} />
    <meta name="author" content="El Hostalet de Tossa & El Bergantí" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="apple-touch-icon" href="/img/favicon.png" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    
    {schema && <SchemaMarkup schema={schema} />}

    <!-- Organization schema (default for all pages) -->
    <SchemaMarkup schema={{
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "El Hostalet de Tossa & El Bergantí",
      "url": "https://alojamientotossademar.com",
      "logo": "https://alojamientotossademar.com/img/favicon.png",
      "sameAs": [
        "https://elberganti-tossa.com/",
        "https://www.hostalhostalet.com/"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tossa de Mar",
        "addressRegion": "Girona",
        "addressCountry": "ES"
      },
      "telephone": "+34 972 34 04 22"
    }} />

    <Font cssVariable="--font-roboto" preload />
    <Font cssVariable="--font-gilda-display" preload />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8EH27HSSVP"></script>
    <script is:inline src="/gtag.js"></script>
  </head>

  <body class="font-sans text-gray-800 pt-20">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />

    <!-- Alpine.js -->
    <script>
      import Alpine from 'alpinejs';
      declare global {
        interface Window {
          Alpine: typeof Alpine;
        }
      }
      window.Alpine = Alpine;
      Alpine.start();
    </script>

    <!-- GLightbox -->
    <script>
      import GLightbox from 'glightbox';

      const hasLightbox = document.querySelector('.glightbox');
      if (hasLightbox) {
        GLightbox({
          selector: '.glightbox',
          touchNavigation: true,
          loop: true,
        });
      }
    </script>

    <script src="@src/scripts/animation.ts"></script>

    <ExitPopup />
  </body>
</html>