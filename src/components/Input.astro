---
import { Icon } from "astro-icon/components";

export interface Props {
  label: string;
  icon?: string;

  // controlled list of allowed types
  type?: 
    | "text"
    | "number"
    | "email"
    | "password"
    | "tel"
    | "url"
    | "search"
    | "date"
    | "time"
    | "datetime-local";

  name?: string;
  placeholder?: string;
  class?: string;
  value?: string;
}

const {
  label,
  icon = null,
  type = "text",
  name = "",
  placeholder = "",
  value = "",
  class: extraClass = "",
} = Astro.props;

const baseClass = `
  px-4 py-3 h-12 bg-white text-gray-800 
  focus:outline-none focus:ring-2 focus:ring-primary
  ${extraClass}
`;
---

<div class="flex flex-col">
  <label class="text-skin-light text-sm mb-2 font-medium flex items-center gap-1">
    {icon && <Icon name={icon} class="w-4 h-4" />}
    {label}
  </label>

  <input
    type={type}
    name={name}
    placeholder={placeholder}
    value={value}
    class={baseClass}
  />
</div>
