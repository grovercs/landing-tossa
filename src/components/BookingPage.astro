---
import BookingInfo from "./BookingInfo.astro";
import BookingForm from "./BookingForm.astro";
import HelpCard from "./HelpCard.astro";
---

<section id="booking" class="py-16 relative bg-white overflow-x-hidden">
  <div class="max-w-7xl relative mx-auto px-4">
    <div class="grid lg:grid-cols-2 gap-8 items-start">

      <!-- LEFT SIDE -->
      <div class="max-lg:order-2 space-y-8">
        <BookingInfo
          title="Información de Reserva"
          items={[
            { icon: "bi:clock", text: "Check-in a partir de las 14:00 h" },
            { icon: "bi:clock-history", text: "Check-out antes de las 12:00 h" },
            { icon: "bi:shield-check", text: "Cancelación gratuita hasta 24 horas antes de la llegada" },
            { icon: "bi:cup-hot", text: "Restaurantes propios en los alojamientos" },
            { icon: "bi:wifi", text: "Wi-Fi gratuito de alta velocidad" },
          ]}
        />

        <HelpCard
          title="¿Necesitas Ayuda?"
          description="Nuestro equipo de recepción está listo para ayudarte con cualquier petición especial."
          items={[
            { icon: "bi:telephone", text: "El Bergantí: +34 972 34 04 22" },
            { icon: "bi:telephone", text: "Hostalet: +34 972 34 00 00" },
          ]}
        />
      </div>

      <!-- RIGHT SIDE -->
      <BookingForm
        fields={[
          { label: "Nombre Completo", type: "text", name: "fullName" },
          { label: "Correo Electrónico", type: "email", name: "email" },
          { label: "Teléfono", type: "text", name: "phone" },
          {
            label: "Alojamiento",
            type: "select",
            name: "roomType",
            options: [
              "El Bergantí - Habitación Doble",
              "Hostalet de Tossa - Habitación Doble",
              "Hostalet de Tossa - Habitación Triple"
            ]
          },
          { label: "Fecha de Entrada", type: "date", name: "checkin" },
          { label: "Fecha de Salida", type: "date", name: "checkout" },
          {
            label: "Adultos",
            type: "select",
            name: "adults",
            options: ["1 Adulto", "2 Adultos", "3 Adultos", "4 Adultos"]
          },
          {
            label: "Niños",
            type: "select",
            name: "children",
            options: ["0 Niños", "1 Niño", "2 Niños", "3 Niños"]
          },
          {
            label: "Peticiones Especiales",
            type: "textarea",
            name: "requests",
            span: 2
          }
        ]}
        submitText="Confirmar Reserva"
      />

    </div>
  </div>
</section>