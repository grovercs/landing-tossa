---
import BookingInfo from "./BookingInfo.astro";
import BookingForm from "./BookingForm.astro";
import HelpCard from "./HelpCard.astro";
---

<section id="booking" class="py-16 relative bg-white overflow-x-hidden">
  <div class="max-w-7xl relative mx-auto px-4">
    <div class="grid lg:grid-cols-2 gap-8 items-start">

      <!-- LEFT SIDE -->
      <div class="max-lg:order-2 space-y-8">
        <BookingInfo
          title="Booking Information"
          items={[
            { icon: "bi:clock", text: "Check-in time starts from 14:00 PM" },
            { icon: "bi:clock-history", text: "Check-out time before 12:00 PM" },
            { icon: "bi:shield-check", text: "Free cancellation up to 24 hours before arrival" },
            { icon: "bi:cup-hot", text: "Breakfast included in all room types" },
            { icon: "bi:wifi", text: "Free high-speed Wi-Fi in every room" },
          ]}
        />

        <HelpCard
          title="Need Assistance?"
          description="Our reservation team is ready to assist you with any special requests or questions."
          items={[
            { icon: "bi:telephone", text: "+47 123 456 789" },
            { icon: "bi:envelope", text: "booking@nordicretreat.com" },
          ]}
        />
      </div>

      <!-- RIGHT SIDE -->
      <BookingForm
        fields={[
          { label: "Full Name", type: "text", name: "fullName" },
          { label: "Email Address", type: "email", name: "email" },
          { label: "Phone Number", type: "text", name: "phone" },
          {
            label: "Room Type",
            type: "select",
            name: "roomType",
            options: [
              "Nordic Serenity Room",
              "Nordic Comfort Suite",
              "Nordic Deluxe Escape",
              "Nordic Family Haven",
              "Nordic Executive Retreat",
              "Nordic Skyline Suite"
            ]
          },
          { label: "Check-in Date", type: "date", name: "checkin" },
          { label: "Check-out Date", type: "date", name: "checkout" },
          {
            label: "Adults",
            type: "select",
            name: "adults",
            options: ["1 Adult", "2 Adults", "3 Adults", "4 Adults"]
          },
          {
            label: "Children",
            type: "select",
            name: "children",
            options: ["0 Child", "1 Child", "2 Children", "3 Children"]
          },
          {
            label: "Special Requests",
            type: "textarea",
            name: "requests",
            span: 2
          }
        ]}
        submitText="Confirm Reservation"
      />

    </div>
  </div>
</section>