---
import { Icon } from "astro-icon/components";
import Input from "../components/Input.astro";
import Select from "../components/Select.astro";
import Button from "../components/Button.astro";
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale || 'es') as keyof typeof import('../i18n/ui').ui;
const t = useTranslations(lang);

// Dictionaries for Adults/Children
const dicts = {
  es: { adult1: "1 Adulto", adult: "Adultos", child0: "0 Niños", child1: "1 Niño", child: "Niños" },
  ca: { adult1: "1 Adult", adult: "Adults", child0: "0 Nens", child1: "1 Nen", child: "Nens" },
  en: { adult1: "1 Adult", adult: "Adults", child0: "0 Children", child1: "1 Child", child: "Children" },
  fr: { adult1: "1 Adulte", adult: "Adultes", child0: "0 Enfants", child1: "1 Enfant", child: "Enfants" },
};

const d = dicts[lang] || dicts.es;

// OPTIONS DATA
const adults = [
  d.adult1, `2 ${d.adult}`, `3 ${d.adult}`, `4 ${d.adult}`, `5 ${d.adult}`,
  `6 ${d.adult}`, `7 ${d.adult}`, `8 ${d.adult}`, `9 ${d.adult}`, `10 ${d.adult}`, "10+"
];

const children = [
  d.child0, d.child1, `2 ${d.child}`, `3 ${d.child}`, `4 ${d.child}`,
  `5 ${d.child}`, `6 ${d.child}`, `7 ${d.child}`, `8 ${d.child}`, `9 ${d.child}`, `10 ${d.child}`, "10+"
];

const roomTypes = [
  "El Bergantí - Habitación Doble",
  "El Bergantí - Habitación Triple",
  "Hostalet de Tossa - Habitación Doble",
  "Hostalet de Tossa - Habitación Triple"
];
---

<section class="bg-primary-dark py-8 overflow-x-hidden">
  <div class="max-w-7xl mx-auto px-4">
    <div class="bg-primary p-6 rounded-lg shadow-xl">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">

        <!-- Check-in -->
        <Input 
          label={t('booking.checkin')} 
          type="date"
          class="w-full"
          icon="bi:calendar-check"
        />

        <!-- Check-out -->
        <Input 
          label={t('booking.checkout')} 
          type="date"
          class="w-full"
          icon="bi:calendar-x"
        />

        <!-- Guests -->
        <div class="flex flex-col">
          <label class="text-skin-light text-sm mb-2 font-medium flex items-center gap-1">
            <Icon name="bi:people" class="w-4 h-4" /> {t('booking.guests')}
          </label>

          <div class="grid grid-cols-2 h-12 gap-2">
            <!-- Adults -->
            <Select 
              label={t('booking.adults')}
              icon="bi:person"
              options={adults}
              hideLabel={true}
              class="flex-1"
            />

            <!-- Children -->
            <Select 
              label={t('booking.children')}
              icon="bi:person-add"
              options={children}
              hideLabel={true}
              class="flex-1"
            />
          </div>
        </div>

        <!-- Rooms -->
        <Select 
          label={t('booking.room')}
          icon="bi:door-open"
          options={roomTypes}
        />

        <!-- Book Button -->
        <div>
          <Button 
            variant="success"
            size="md"
            icon="bi:journal-check"
            iconPosition="left"
            class="w-full h-12 bg-green-700/90 hover:bg-green-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
          >
            {t('booking.search')}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
