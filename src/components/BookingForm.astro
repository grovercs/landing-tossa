---
import { Icon } from "astro-icon/components";

export interface Field {
  label: string;
  type: "text" | "email" | "date" | "select" | "textarea";
  name: string;
  options?: string[];
  span?: number;
}

export interface Props {
  fields: Field[];
  submitText?: string;
}

const { fields, submitText = "Confirm Reservation" } = Astro.props;
---
<div class="bg-primary-dark p-8 rounded-tl-3xl shadow-lg">
  <form class="grid grid-cols-2 gap-5">

    {fields.map((field) => (
      <div class={field.span === 2 ? "col-span-2" : "col-span-2 md:col-span-1"}>
        <label class="text-sm text-white mb-1 block">
          {field.label}
        </label>

        {field.type === "textarea" ? (
          <textarea
            rows="4"
            name={field.name}
            class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
          ></textarea>
        ) : field.type === "select" ? (
          <select
            name={field.name}
            class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
          >
            {field.options?.map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
        ) : (
          <input
            type={field.type}
            name={field.name}
            class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
          />
        )}
      </div>
    ))}

    <!-- Submit -->
    <div class="col-span-2">
      <button
        type="submit"
        class="w-full flex items-center gap-2 justify-center bg-green-700 text-white px-8 py-4 hover:bg-green-800 transition text-lg"
      >
        <Icon name="bi:journal-check" class="text-lg" />
        {submitText}
      </button>
    </div>
  </form>
</div>