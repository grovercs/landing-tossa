---
import FacilityCard from "./FacilityCard.astro";

export interface FacilityItem {
  icon: string;
  title: string;
  description: string;
}

export interface Props {
  id?: string;
  title: string;
  subtitle: string;
  imageDecor?: string | null;
  facilities: FacilityItem[];
}

const {
  id = "facilities",
  title,
  subtitle,
  imageDecor = null,
  facilities,
} = Astro.props;
---

<section id={id} class="py-20 bg-skin-light overflow-x-hidden">
  <div class="max-w-7xl mx-auto relative px-4">
    <!-- DECORATIVE IMAGE -->
    {imageDecor && (
      <div class="absolute -top-28 md:-top-20 right-0">
        <img src={imageDecor} class="w-16 sm:w-20" alt="decor-image" loading="lazy" />
      </div>
    )}

    <div class="flex flex-col relative gap-8">
      <!-- SECTION HEADING -->
      <div class="max-w-2xl">
        <h2 class="font-heading text-4xl lg:text-5xl text-primary-dark mb-4">
          {title}
        </h2>
        <p class="text-gray-700 text-lg leading-relaxed">
          {subtitle}
        </p>
      </div>

      <!-- FACILITY CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {facilities.map((item) => (
          <FacilityCard item={item} />
        ))}
      </div>
    </div>
  </div>
</section>
