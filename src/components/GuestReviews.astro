---
import { Icon } from "astro-icon/components";

export interface Props {
  lang?: "es" | "ca" | "en" | "fr";
}

const { lang = "es" } = Astro.props;

const t = {
  es: {
    title: "Lo que dicen nuestros huéspedes",
    reviews: [
      {
        name: "María G.",
        location: "Madrid, España",
        rating: 5,
        text: "Nos alojamos en El Hostalet y fue una experiencia inolvidable. La terraza junto a la iglesia de Sant Vicenç es mágica para desayunar. ¡Volveremos seguro!",
        source: "Google"
      },
      {
        name: "Jean-Pierre L.",
        location: "París, Francia",
        rating: 5,
        text: "El Bergantí tiene una ubicación perfecta en el centro de Tossa. Las tapas del restaurante son excepcionales y el trato familiar hace que te sientas como en casa.",
        source: "Booking.com"
      }
    ]
  },
  ca: {
    title: "El que diuen els nostres hostes",
    reviews: [
      {
        name: "María G.",
        location: "Madrid, Espanya",
        rating: 5,
        text: "Ens vam allotjar a L'Hostalet i va ser una experiència inoblidable. La terrassa al costat de l'església de Sant Vicenç és màgica per esmorzar. Tornarem segur!",
        source: "Google"
      },
      {
        name: "Jean-Pierre L.",
        location: "París, França",
        rating: 5,
        text: "El Bergantí té una ubicació perfecta al centre de Tossa. Les tapes del restaurant són excepcionals i el tracte familiar fa que et sentis com a casa.",
        source: "Booking.com"
      }
    ]
  },
  en: {
    title: "What our guests say",
    reviews: [
      {
        name: "María G.",
        location: "Madrid, Spain",
        rating: 5,
        text: "We stayed at Hostalet de Tossa and it was an unforgettable experience. The terrace next to the Sant Vicenç church is magical for breakfast. We will definitely come back!",
        source: "Google"
      },
      {
        name: "Jean-Pierre L.",
        location: "Paris, France",
        rating: 5,
        text: "El Bergantí has a perfect location in the center of Tossa. The tapas at the restaurant are exceptional and the family atmosphere makes you feel at home.",
        source: "Booking.com"
      }
    ]
  },
  fr: {
    title: "Ce que disent nos clients",
    reviews: [
      {
        name: "María G.",
        location: "Madrid, Espagne",
        rating: 5,
        text: "Nous avons séjourné à L'Hostalet et ce fut une expérience inoubliable. La terrasse à côté de l'église Sant Vicenç est magique pour le petit-déjeuner. Nous reviendrons sans aucun doute !",
        source: "Google"
      },
      {
        name: "Jean-Pierre L.",
        location: "Paris, France",
        rating: 5,
        text: "El Bergantí dispose d'un emplacement parfait au centre de Tossa. Les tapas du restaurant sont exceptionnelles et l'ambiance familiale vous fait vous sentir comme chez vous.",
        source: "Booking.com"
      }
    ]
  }
};

const d = t[lang] || t.es;
---

<div class="border-t border-gray-200 pt-10 mt-10">
  <h3 class="text-2xl font-heading text-primary-dark mb-6">{d.title}</h3>
  <div class="grid md:grid-cols-2 gap-6">
    {d.reviews.map((review) => (
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
        <div class="flex items-center gap-1 mb-3">
          {Array.from({ length: review.rating }).map(() => (
            <Icon name="bi:star-fill" class="text-yellow-400 text-sm" />
          ))}
        </div>
        <p class="text-gray-700 mb-4 italic leading-relaxed">
          "{review.text}"
        </p>
        <div class="flex items-center justify-between">
          <div>
            <p class="font-semibold text-gray-800">{review.name}</p>
            <p class="text-sm text-gray-500">{review.location}</p>
          </div>
          <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded">{review.source}</span>
        </div>
      </div>
    ))}
  </div>
</div>
