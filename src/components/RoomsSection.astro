---
import RoomCard from "./RoomCard.astro";
import Pagination from "./Pagination.astro";
import { getCollection } from "astro:content";

export interface Props {
  title?: string;
  description?: string;
  maxPosts?: number;     
  currentPage?: number;   // default 1
  baseUrl?: string;     
}

const lang = (Astro.currentLocale || 'es') as string;

const {
  title,
  description,
  maxPosts = 6,
  currentPage = 1,
  baseUrl = lang === 'es' ? "/rooms/page/" : `/${lang}/rooms/page/`,
} = Astro.props;

// ==============================
// GET & SORT ROOMS
// ==============================
const allRooms = await getCollection("rooms", ({ id }) => id.startsWith(`${lang}/`));

// Sort: Hostalet first, then El Bergantí (Hostalet is the main property)
const sortedRooms = allRooms.sort((a, b) => {
  const slugA = a.id.split('/').pop()?.replace(/\.mdx$/, '') || '';
  const slugB = b.id.split('/').pop()?.replace(/\.mdx$/, '') || '';
  const order: Record<string, number> = { 'hostalet': 0, 'el-berganti': 1 };
  return (order[slugA] ?? 99) - (order[slugB] ?? 99);
});

// ==============================
// PAGINATION LOGIC
// ==============================
const totalPages = Math.ceil(sortedRooms.length / maxPosts);

const start = (currentPage - 1) * maxPosts;
const end = start + maxPosts;
const visibleRooms = sortedRooms.slice(start, end);
---
<section id="rooms" class="py-20 bg-skin-light overflow-x-hidden">
  <div class="max-w-7xl mx-auto px-4">

    <!-- Heading -->
    {(title || description) && (
      <div class="max-w-2xl mx-auto mb-12 text-center">
        {title && (
          <h2 class="font-heading text-4xl lg:text-5xl text-primary-dark mb-4">
            {title}
          </h2>
        )}

        {description && (
          <p class="text-gray-700 text-lg leading-relaxed">
            {description}
          </p>
        )}
      </div>
    )}

    <!-- Room Cards -->
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {visibleRooms.map((room) => (
          <RoomCard room={room} />
        ))}
      </div>
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="mt-16 flex justify-center">
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          baseUrl={baseUrl}
        />
      </div>
    )}
  </div>
</section>