---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data, body } = post;
const slug = post.id.replace(/\.mdx$/, "");

// Convert string date → Date object
const postDate =
  typeof data.date === "string" ? new Date(data.date) : data.date;

// Format date (Indonesia)
const formattedDate = new Intl.DateTimeFormat("id-ID", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(postDate);

const url = `/blogs/${slug}/`;
---

<div class="bg-white rounded-tl-2xl rounded-br-2xl overflow-hidden shadow-lg">
  <div class="relative aspect-video bg-gray-100 overflow-hidden">
    <a href={url}>
      <img src={data.image} alt={data.title} class="w-full object-cover" loading="lazy" />
    </a>
  </div>

  <div class="p-6">
    <h3 class="text-xl font-semibold text-primary-dark hover:text-deep-primary mb-2">
      <a href={url}>{data.title}</a>
    </h3>

    <p class="text-gray-500 mb-4">
      {data.description ?? (body ? body.slice(0, 120) + "..." : "")}
    </p>

    <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-5">
      <span class="flex items-center gap-1">
        <Icon name="bi:calendar-event" /> {formattedDate}
      </span>

      <span class="flex items-center gap-1">
        <Icon name="bi:person" /> {data.author}
      </span>

      {data.tags && data.tags.length > 0 && (
        <span class="flex items-center gap-1">
          <Icon name="bi:tag" /> {data.tags[0]}
        </span>
      )}
    </div>

    <div class="flex items-center justify-between">
      <span class="text-heading font-semibold text-wood">{data.readingTime} Min Read</span>

      <a
        href={url}
        class="px-5 py-2 border-2 border-primary text-primary hover:bg-primary hover:text-white transition"
      >
        Read More
      </a>
    </div>
  </div>
</div>