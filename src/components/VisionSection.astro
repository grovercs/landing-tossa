---
import VisionCard, { type VisionCardItem } from "./VisionCard.astro";

export interface Props {
  id?: string;
  title: string;
  subtitle: string;
  items: VisionCardItem[]; // list of vision/mission cards
}

const {
  id = "vision",
  title,
  subtitle,
  items = []
} = Astro.props;
---

<section id={id} class="py-20 bg-skin-light relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4">
    
    <!-- Heading -->
    <div class="text-center mb-12">
      <h2 class="font-heading text-4xl lg:text-5xl text-primary-dark mb-6">
        {title}
      </h2>
      <p class="text-gray-700 text-lg max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {items.map((item) => (
        <VisionCard item={item} />
      ))}
    </div>
  </div>
</section>