---
export interface PortalItem {
  name: string;
  description: string;
  url: string;
  domain: string;
  category: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Ens trobaràs a...",
  subtitle = "Col·laborem amb les principals plataformes i organismes turístics de la Costa Brava i Catalunya per oferir-te la millor experiència.",
} = Astro.props;

const portals: PortalItem[] = [
  {
    name: "Visit Tossa",
    description: "Oficina de Turisme de Tossa de Mar",
    url: "https://visittossa.com",
    domain: "visittossa.com",
    category: "Turisme Municipal",
  },
  {
    name: "Costa Brava Girona",
    description: "Patronat de Turisme Costa Brava",
    url: "https://costabrava.org",
    domain: "costabrava.org",
    category: "Turisme Regional",
  },
  {
    name: "La Selva Turisme",
    description: "Associació de Turisme La Selva",
    url: "https://laselvaturisme.com",
    domain: "laselvaturisme.com",
    category: "Turisme Comarcal",
  },
  {
    name: "Agència Catalana de Turisme",
    description: "Generalitat de Catalunya",
    url: "https://act.gencat.cat",
    domain: "act.gencat.cat",
    category: "Turisme Autonòmic",
  },
  {
    name: "Federació d'Hostaleria Girona",
    description: "Federació d'Hostaleria i Turisme",
    url: "https://gihostaleria.org",
    domain: "gihostaleria.org",
    category: "Gremi Sectorial",
  },
  {
    name: "Federatur · ATA Girona",
    description: "Apartaments Turístics Costa Brava",
    url: "https://apartmentsandvillasgirona.org",
    domain: "apartmentsandvillasgirona.org",
    category: "Associació Sectorial",
  },
  {
    name: "Apartments & Villas Costa Brava",
    description: "Directori d'apartaments de la Costa Brava",
    url: "https://apartmentsandvillascostabrava.com",
    domain: "apartmentsandvillascostabrava.com",
    category: "Directori Turístic",
  },
  {
    name: "Vacances Costa Brava",
    description: "Portal d'allotjaments i vacances",
    url: "https://vacancescostabrava.cat",
    domain: "vacancescostabrava.cat",
    category: "Directori Turístic",
  },
  {
    name: "Costa Brava Sí",
    description: "Portal turístic de la Costa Brava",
    url: "https://costabravasi.com",
    domain: "costabravasi.com",
    category: "Directori Turístic",
  },
];
---

<section id="tourism-presence" class="py-20 bg-skin-light overflow-x-hidden">
  <div class="max-w-7xl mx-auto px-4">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block text-xs uppercase tracking-widest text-accent font-semibold mb-3 border border-accent/40 px-4 py-1 rounded-full">
        Presència Oficial
      </span>
      <h2 class="font-heading text-4xl lg:text-5xl text-primary-dark mb-4">
        {title}
      </h2>
      <p class="text-gray-600 text-lg leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Portal Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {portals.map((portal, index) => (
        <a
          href={portal.url}
          target="_blank"
          rel="noopener noreferrer"
          class="portal-card group relative bg-white border border-gray-100 rounded-tl-2xl rounded-br-2xl p-5 flex items-center gap-4 shadow-sm hover:shadow-md hover:border-accent/30 transition-all duration-300"
          style={`animation-delay: ${index * 60}ms`}
        >
          <!-- Favicon / Logo -->
          <div class="flex-shrink-0 w-14 h-14 rounded-tl-xl rounded-br-xl bg-skin-light flex items-center justify-center overflow-hidden border border-gray-100 group-hover:border-accent/40 transition-colors duration-300">
            <img
              src={`https://www.google.com/s2/favicons?domain=${portal.domain}&sz=64`}
              alt={`Logo de ${portal.name}`}
              class="w-8 h-8 object-contain"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <!-- Fallback icon -->
            <div class="hidden w-8 h-8 items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-primary/50">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </div>
          </div>

          <!-- Text -->
          <div class="flex-1 min-w-0">
            <span class="inline-block text-[10px] uppercase tracking-wider text-accent font-semibold mb-0.5">
              {portal.category}
            </span>
            <h3 class="font-heading text-base text-primary-dark leading-snug group-hover:text-primary transition-colors duration-200 truncate">
              {portal.name}
            </h3>
            <p class="text-gray-500 text-xs mt-0.5 leading-snug truncate">
              {portal.description}
            </p>
          </div>

          <!-- Arrow -->
          <div class="flex-shrink-0 opacity-0 group-hover:opacity-100 translate-x-0 group-hover:translate-x-1 transition-all duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-accent">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>

          <!-- Corner accent -->
          <div class="absolute bottom-0 right-0 w-8 h-8 overflow-hidden rounded-br-2xl">
            <div class="absolute bottom-0 right-0 w-4 h-4 bg-accent/10 group-hover:bg-accent/20 transition-colors duration-300 rounded-tl-lg"></div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom note -->
    <p class="text-center text-gray-400 text-sm mt-10">
      Reserva directament a la nostra web i obté el millor preu garantit.
    </p>
  </div>
</section>

<style>
  .portal-card {
    opacity: 0;
    transform: translateY(20px);
    animation: cardFadeIn 0.5s ease forwards;
  }

  @keyframes cardFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Intersection Observer para animar solo cuando es visible
  const cards = document.querySelectorAll('.portal-card');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.animationPlayState = 'running';
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  cards.forEach((card) => {
    (card as HTMLElement).style.animationPlayState = 'paused';
    observer.observe(card);
  });
</script>
