---
export interface Props {
  src?: string;
  alt?: string;
  height?: string;
  href?: string;
}

const {
  src = "/images/alojamientos-tossa-de-mar-logo.png",
  alt = "Alojamientos Tossa de Mar",
  height = "h-12 lg:h-14",
  href = "/",
} = Astro.props;
---

<a href={href} class="flex items-center">
  <img src={src} alt={alt} class={height} />
</a>
