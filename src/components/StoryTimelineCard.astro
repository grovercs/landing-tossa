---
export interface StoryTimelineItem {
  year: string;        // "2020 — The Beginning"
  description: string; // "Nordicia opens its doors..."
}

export interface Props {
  item: StoryTimelineItem;
}

const { item } = Astro.props;
---

<div class="relative">
  <div class="absolute -left-11 top-1 w-6 h-6 bg-primary rounded-full"></div>

  <h4 class="text-xl font-semibold text-gray-800 mb-1">
    {item.year}
  </h4>

  <p class="text-gray-600 text-sm">
    {item.description}
  </p>
</div>