---
import { Icon } from "astro-icon/components";

export interface HelpItem {
  icon: string;
  text: string;
}

export interface Props {
  title: string;
  description: string;
  items: HelpItem[];
}

const { title, description, items } = Astro.props;
---

<div class="bg-wood-dark p-8 text-white rounded-tl-3xl shadow-lg">
  <h3 class="font-heading text-2xl mb-4">{title}</h3>

  <p class="text-white/90 mb-6">
    {description}
  </p>

  <div class="space-y-3">
    {items.map((i) => (
      <div class="flex items-center gap-3">
        <Icon name={i.icon} class="text-xl" />
        <span>{i.text}</span>
      </div>
    ))}
  </div>
</div>