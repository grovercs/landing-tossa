---
import { Icon } from "astro-icon/components";

export interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string; // default: "/blogs/page/"
}

const {
  currentPage,
  totalPages,
  baseUrl = "/blogs/page/",
} = Astro.props;

// Build URL helper
const buildHref = (page: number) => {
  if (page === 1) return "/blogs/";
  return `${baseUrl}${page}/`;
};

// Pagination range logic
const getPages = () => {
  const pages: (number | "...")[] = [];

  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) pages.push(i);
    return pages;
  }

  pages.push(1);

  if (currentPage > 3) pages.push("...");

  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }

  if (currentPage < totalPages - 2) pages.push("...");

  pages.push(totalPages);

  return pages;
};

const pages = getPages();
---

<nav class="flex items-center justify-center gap-2" aria-label="Pagination">
  <!-- PREV -->
  <a
    href={currentPage > 1 ? buildHref(currentPage - 1) : "#"}
    aria-disabled={currentPage === 1}
    class={`flex items-center justify-center w-10 h-10 border transition
      ${currentPage === 1
        ? "border-gray-200 text-gray-300 cursor-not-allowed"
        : "border-gray-300 text-gray-600 hover:bg-primary hover:text-white hover:border-primary"}
    `}
  >
    <Icon name="bi:chevron-left" />
  </a>

  <!-- PAGE NUMBERS -->
  {pages.map((p) =>
    p === "..." ? (
      <span class="px-3 text-gray-400 select-none">…</span>
    ) : (
      <a
        href={buildHref(p)}
        class={`flex items-center justify-center w-10 h-10 border font-semibold transition
          ${
            p === currentPage
              ? "border-primary bg-primary text-white"
              : "border-gray-300 text-gray-700 hover:bg-primary hover:text-white hover:border-primary"
          }
        `}
      >
        {p}
      </a>
    )
  )}

  <!-- NEXT -->
  <a
    href={currentPage < totalPages ? buildHref(currentPage + 1) : "#"}
    aria-disabled={currentPage === totalPages}
    class={`flex items-center justify-center w-10 h-10 border transition
      ${currentPage === totalPages
        ? "border-gray-200 text-gray-300 cursor-not-allowed"
        : "border-gray-300 text-gray-600 hover:bg-primary hover:text-white hover:border-primary"}
    `}
  >
    <Icon name="bi:chevron-right" />
  </a>
</nav>
