---
import Button from "../components/Button.astro";

export interface Props {
  title?: string;
  message?: string;
  background?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "404 — Page Not Found",
  message = "Sorry, the page you are looking for might have been removed, had its name changed, or is temporarily unavailable.",
  background = "/img/pool.jpg",
  ctaLabel = "Back to Home",
  ctaHref = "/",
} = Astro.props;
---

<section class="relative pt-14 pb-20 lg:py-24 flex items-center overflow-x-hidden">
  <!-- Background Image -->
  <img 
    src={background}
    alt="Not Found Background"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <!-- Decorative block -->
    <div class="absolute -bottom-8 -right-8 w-48 h-48 bg-primary/90"></div>

    <!-- Card -->
    <div class="max-w-2xl bg-white/85 p-6 md:p-12 relative text-center rounded-tl-3xl">
      <!-- Title -->
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-primary-dark mb-4">
        {title}
      </h1>

      <!-- Description -->
      <p class="text-gray-700 mb-6 text-lg">
        {message}
      </p>

      <!-- CTA Button -->
      <div class="flex max-sm:flex-col items-center justify-center gap-4">
        <Button
          href={ctaHref}
          variant="primary"
          size="md"
          icon="bi:arrow-left"
          iconPosition="left"
        >
          {ctaLabel}
        </Button>
      </div>
    </div>
  </div>
</section>
