---
import { Icon } from "astro-icon/components";

export interface Field {
  label: string;
  type: "text" | "email" | "textarea";
  name: string;
  span?: number;       // 1 or 2
}

export interface Props {
  fields?: Field[];
  submitText?: string;
}

const {
  fields = [
    { label: "Nombre Completo", type: "text", name: "fullName" },
    { label: "Correo Electrónico", type: "email", name: "email" },
    { label: "Teléfono", type: "text", name: "phone" },
    { label: "Asunto", type: "text", name: "subject" },
    { label: "Mensaje", type: "textarea", name: "message", span: 2 }
  ],
  submitText = "Enviar Mensaje",
} = Astro.props;

const lang = (Astro.currentLocale || 'es') as string;
const successUrls = {
  es: '/reserva-enviada/',
  ca: '/ca/reserva-enviada/',
  en: '/en/booking-sent/',
  fr: '/fr/reservation-envoyee/',
};
const successUrl = successUrls[lang] || successUrls.es;
---

<div class="bg-wood p-8 rounded-tl-3xl shadow-lg">
  <form
    name="contact"
    method="POST"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    action={successUrl}
    class="grid grid-cols-1 md:grid-cols-2 gap-5"
  >
    <!-- Honeypot field for spam prevention -->
    <p class="hidden">
      <label>Don't fill this out if you're human: <input name="bot-field" /></label>
    </p>

    <!-- Hidden form name for Netlify -->
    <input type="hidden" name="form-name" value="contact" />

    {fields.map((field) => (
      <div class={field.span === 2 ? "md:col-span-2" : ""}>
        <label class="text-sm text-white mb-1 block">{field.label}</label>

        {field.type === "textarea" ? (
          <textarea
            rows="5"
            name={field.name}
            class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
          ></textarea>
        ) : (
          <input
            type={field.type}
            name={field.name}
            class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
          />
        )}
      </div>
    ))}

    <div class="md:col-span-2">
      <button type="submit"
        class="w-full flex items-center gap-2 justify-center bg-primary text-white px-8 py-4 hover:bg-primary-dark transition text-lg">
        <Icon name="bi:send" class="text-lg" />
        {submitText}
      </button>
    </div>
  </form>
</div>
