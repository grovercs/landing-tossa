---
import { Icon } from "astro-icon/components";

export interface Field {
  label: string;
  type: "text" | "email" | "textarea";
  name: string;
  span?: number;       // 1 or 2
}

export interface Props {
  fields?: Field[];
  submitText?: string;
}

const {
  fields = [
    { label: "Full Name", type: "text", name: "fullName" },
    { label: "Email Address", type: "email", name: "email" },
    { label: "Phone Number", type: "text", name: "phone" },
    { label: "Subject", type: "text", name: "subject" },
    { label: "Message", type: "textarea", name: "message", span: 2 }
  ],
  submitText = "Send Message",
} = Astro.props;
---

<div class="bg-wood p-8 rounded-tl-3xl shadow-lg">
  <form class="grid grid-cols-1 md:grid-cols-2 gap-5">

    {fields.map((field) => (
      <div class={field.span === 2 ? "md:col-span-2" : ""}>
        <label class="text-sm text-white mb-1 block">{field.label}</label>

        {field.type === "textarea" ? (
          <textarea
            rows="5"
            name={field.name}
            class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
          ></textarea>
        ) : (
          <input
            type={field.type}
            name={field.name}
            class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
          />
        )}
      </div>
    ))}

    <div class="md:col-span-2">
      <button type="submit"
        class="w-full flex items-center gap-2 justify-center bg-primary text-white px-8 py-4 hover:bg-primary-dark transition text-lg">
        <Icon name="bi:send" class="text-lg" />
        {submitText}
      </button>
    </div>
  </form>
</div>