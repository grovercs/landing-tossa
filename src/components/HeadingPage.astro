---
export interface Props {
  title: string;
  subtitle?: string;
  background?: string;
  align?: "left" | "center";
}

const {
  title,
  subtitle = "",
  background = "/img/hero1.jpg",
  align = "left",
} = Astro.props;

const alignmentClass =
  align === "center" ? "text-center mx-auto" : "text-left";
---

<section class="relative pt-14 pb-20 lg:py-24 bg-gray-200 flex items-center overflow-x-hidden">
  <!-- Background Image -->
  <img 
    src={background}
    alt="Page Header Background"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <!-- Decorative block -->
    <div class="absolute -bottom-8 -right-8 w-48 h-48 bg-primary/90"></div>
    <div class={`max-w-2xl bg-white/85 p-6 md:p-12 relative rounded-tl-3xl ${alignmentClass}`}>
      <!-- Title -->
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-primary-dark mb-3">
        {title}
      </h1>

      <!-- Subtitle (optional) -->
      {subtitle && (
        <p class="text-gray-700 mb-4 text-lg">
          {subtitle}
        </p>
      )}

    </div>
  </div>
</section>