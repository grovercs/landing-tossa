---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

export interface Props {
  related: CollectionEntry<"blog">[];
  lang?: "es" | "ca" | "en" | "fr";
  currentUrl: string;
}

const { related, lang = "es", currentUrl } = Astro.props;

const translations = {
  es: {
    bookTitle: "Reserva tu Estancia",
    bookDesc: "Consigue el mejor precio reservando directamente con nosotros.",
    bookBtn: "Ver Disponibilidad",
    shareTitle: "Compartir Artículo",
    relatedTitle: "Publicaciones Recientes"
  },
  en: {
    bookTitle: "Book Your Stay",
    bookDesc: "Get the best price by booking directly with us.",
    bookBtn: "Check Availability",
    shareTitle: "Share Article",
    relatedTitle: "Recent Posts"
  },
  ca: {
    bookTitle: "Reserva la teva Estada",
    bookDesc: "Aconsegueix el millor preu reservant directament amb nosaltres.",
    bookBtn: "Veure Disponibilitat",
    shareTitle: "Compartir Article",
    relatedTitle: "Publicacions Recents"
  },
  fr: {
    bookTitle: "Réservez votre Séjour",
    bookDesc: "Obtenez le meilleur prix en réservant directement avec nous.",
    bookBtn: "Voir les Disponibilités",
    shareTitle: "Partager l'Article",
    relatedTitle: "Articles Récents"
  }
};

const t = translations[lang] || translations.es;
const bookingLink = lang === 'es' ? '/reservas' : `/${lang}/reservas`; // Adjust if booking route differs

const fbShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;
const twShare = `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}`;
const waShare = `https://wa.me/?text=${encodeURIComponent(currentUrl)}`;
---

<aside class="sticky top-24 space-y-8">
  
  {/* CTA Widget */}
  <div class="bg-primary/5 border border-primary/20 rounded-2xl p-6 text-center shadow-sm">
    <h3 class="text-2xl font-heading text-primary-dark mb-2">{t.bookTitle}</h3>
    <p class="text-gray-600 mb-6">{t.bookDesc}</p>
    <a href={bookingLink} class="inline-block w-full py-3 px-4 bg-primary text-white font-semibold rounded hover:bg-deep-primary transition uppercase tracking-wider text-sm">
      {t.bookBtn}
    </a>
  </div>

  {/* Social Share Widget */}
  <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">{t.shareTitle}</h3>
    <div class="flex gap-4">
      <a href={waShare} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-green-500 text-white flex items-center justify-center hover:bg-green-600 transition" aria-label="Share on WhatsApp">
        <Icon name="bi:whatsapp" class="text-xl" />
      </a>
      <a href={fbShare} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center hover:bg-blue-700 transition" aria-label="Share on Facebook">
        <Icon name="bi:facebook" class="text-xl" />
      </a>
      <a href={twShare} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-black text-white flex items-center justify-center hover:bg-gray-800 transition" aria-label="Share on Twitter/X">
        <Icon name="bi:twitter-x" class="text-xl" />
      </a>
    </div>
  </div>

  {/* Related Posts Widget */}
  {related && related.length > 0 && (
    <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">{t.relatedTitle}</h3>
      <div class="space-y-4">
        {related.map(post => {
          const slug = post.id.split('/').pop()?.replace(/\.mdx$/, '');
          const url = lang === 'es' ? `/blogs/${slug}` : `/${lang}/blogs/${slug}`;
          return (
            <a href={url} class="flex gap-4 group">
              <img src={post.data.image} alt={post.data.title} class="w-20 h-20 object-cover rounded shadow-sm group-hover:opacity-80 transition" loading="lazy" />
              <div class="flex flex-col justify-center">
                <h4 class="text-sm font-semibold text-gray-800 group-hover:text-primary transition line-clamp-2">{post.data.title}</h4>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}

</aside>
