---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale || 'es') as keyof typeof import('../i18n/ui').ui;
const t = useTranslations(lang);
const basePath = lang === 'es' ? '' : `/${lang}`;

export interface FooterLink {
  label: string;
  href: string;
}

export interface ContactItem {
  icon: string;
  text: string | string[];
}

export interface FooterBrand {
  name: string;
  tagline: string;
}

export interface FooterCopyright {
  year: number;
  brand: string;
  text: string;
}

const brandInfo: FooterBrand = {
  name: "Tossa de Mar",
  tagline: t('footer.tagline')
};

const getLocalizedContact = () => {
  if (lang === 'es') return `/contacto`;
  if (lang === 'ca') return `/ca/contacte`;
  if (lang === 'en') return `/en/contact`;
  if (lang === 'fr') return `/fr/contact`;
  return `/contacto`;
};

const getLocalizedBlog = () => {
  if (lang === 'es') return `/blogs`;
  if (lang === 'ca') return `/ca/blogs`;
  if (lang === 'en') return `/en/blogs`;
  if (lang === 'fr') return `/fr/blogs`;
  return `/blogs`;
};

const hostaletLabel = lang === 'ca' || lang === 'fr' ? "L'Hostalet de Tossa" : lang === 'es' ? "El Hostalet de Tossa" : "Hostalet de Tossa";

const exploreLinks: FooterLink[] = [
  { label: t('nav.blog'), href: getLocalizedBlog() },
  { label: t('nav.contact'), href: getLocalizedContact() },
  { label: hostaletLabel, href: "https://www.hostalhostalet.com/" },
  { label: "El Bergantí", href: "https://elberganti-tossa.com/" }
];

const socialLinks = [
  { icon: "bi:facebook", href: "#" },
  { icon: "bi:instagram", href: "#" },
  { icon: "bi:twitter-x", href: "#" },
  { icon: "bi:tiktok", href: "#" },
];

const contact: ContactItem[] = [
  { icon: "bi:geo-alt", text: ["Tossa de Mar", "Costa Brava, Girona"] },
  { icon: "bi:house", text: [`${lang === 'ca' || lang === 'fr' ? "L'Hostalet" : lang === 'es' ? "El Hostalet" : "Hostalet"}: +34 634 39 83 57`, "El Bergantí: +34 682 04 79 50"] }
];

const copyright: FooterCopyright = {
  year: new Date().getFullYear(),
  brand: hostaletLabel + " & El Bergantí",
  text: t('footer.rights')
};
---

<footer id="footer" class="bg-deep-primary text-white pt-16 pb-12 overflow-x-hidden">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">

      <!-- BRAND -->
      <div>
        <h3 class="font-heading text-2xl mb-4">{brandInfo.name.toUpperCase()}</h3>
        <p class="text-white/70 mb-4">{brandInfo.tagline}</p>
        {/* Social links hidden until real URLs are provided */}
        {/*
        <div class="flex gap-4">
          {socialLinks.map(s => (
            <a href={s.href} class="text-white/70 hover:text-accent transition">
              <Icon name={s.icon} class="text-xl" />
            </a>
          ))}
        </div>
        */}
      </div>

      <!-- EXPLORE -->
      <div>
        <h4 class="font-heading text-lg mb-4">{t('footer.links')}</h4>
        <ul class="space-y-2">
          {exploreLinks.map(item => (
            <li>
              <a href={item.href} class="text-white/70 hover:text-accent transition">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CONTACT -->
      <div>
        <h4 class="font-heading text-lg mb-4">{t('footer.contact')}</h4>
        <ul class="space-y-2 text-white/70">
          {contact.map(item => (
            <li class="flex items-start gap-2">
              <Icon name={item.icon} class="text-white mt-1" />
              {Array.isArray(item.text) ? (
                <span>{item.text[0]}<br />{item.text[1]}</span>
              ) : (
                <span>{item.text}</span>
              )}
            </li>
          ))}
        </ul>
      </div>


    </div>

    <!-- HOTEL LOGOS -->
    <div class="border-t border-white/20 pt-8 pb-6 flex flex-col items-center gap-4">
      <p class="text-white/60 text-sm mb-2">{t('footer.partOf')}</p>
      <div class="flex items-center justify-center gap-8 flex-wrap">
        <a
          href="https://www.hostalhostalet.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="opacity-80 hover:opacity-100 transition"
          aria-label={hostaletLabel}
        >
          <img
            src="/images/logo-lhostalet.avif"
            alt={hostaletLabel}
            class="h-10 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <a
          href="https://elberganti-tossa.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="opacity-80 hover:opacity-100 transition"
          aria-label="El Bergantí"
        >
          <img
            src="/images/berganti.webp"
            alt="El Bergantí"
            class="h-10 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>

    <!-- COPYRIGHT -->
    <div class="border-t border-white/20 pt-8 text-center text-white/70">
      <p>
        &copy; {copyright.year}
        {` ${copyright.brand}. `}
        {copyright.text}
      </p>
    </div>
  </div>
</footer>