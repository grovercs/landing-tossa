---
import { Icon } from "astro-icon/components";

export interface VisionCardItem {
  icon: string;        // "bi:eye"
  title: string;       // "Our Vision"
  description: string;
  points?: string[];   // bullet list
}

export interface Props {
  item: VisionCardItem;
}

const { item } = Astro.props;
---

<div class="bg-white p-6 shadow-md hover:shadow-xl transition group rounded-tl-2xl rounded-br-2xl">
  <!-- Icon -->
  <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary transition">
    <Icon name={item.icon} class="text-2xl text-primary group-hover:text-white transition" />
  </div>

  <!-- Title -->
  <h3 class="text-2xl font-semibold text-gray-800 mb-4">
    {item.title}
  </h3>

  <!-- Description -->
  <p class="text-gray-600 mb-4">
    {item.description}
  </p>

  <!-- Bullet Points -->
  {item.points && item.points.length > 0 && (
    <ul class="space-y-2 text-gray-600 list-disc pl-5">
      {item.points.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
  )}
</div>