---
import { Icon } from "astro-icon/components";
import { useTranslations } from "../i18n/utils";

export interface Props {
  roomTitle: string;
  price: number;
}

const { roomTitle, price } = Astro.props;
const lang = (Astro.currentLocale || 'es') as keyof typeof import('../i18n/ui').ui;
const t = useTranslations(lang);

const successUrls = {
  es: '/reserva-enviada/',
  ca: '/ca/reserva-enviada/',
  en: '/en/booking-sent/',
  fr: '/fr/reservation-envoyee/',
};
const successUrl = successUrls[lang] || successUrls.es;

const dicts = {
  es: { adult1: "1 Adulto", adult: "Adultos", child0: "0 Niños", child1: "1 Niño", child: "Niños" },
  ca: { adult1: "1 Adult", adult: "Adults", child0: "0 Nens", child1: "1 Nen", child: "Nens" },
  en: { adult1: "1 Adult", adult: "Adults", child0: "0 Children", child1: "1 Child", child: "Children" },
  fr: { adult1: "1 Adulte", adult: "Adultes", child0: "0 Enfants", child1: "1 Enfant", child: "Enfants" },
};
const d = dicts[lang] || dicts.es;
---
<div class="bg-primary-dark p-6 sm:p-8 rounded-tl-3xl shadow-lg mb-8">
  <!-- ROOM INFO -->
  <div class="mb-6 pb-4 border-b border-white/10">
    <span class="text-sm text-white/70 mb-1 block">{t('bookingForm.roomType')}</span>
    <span class="text-heading font-semibold text-white text-lg">
      {roomTitle}
    </span>
    {(price && price > 0) && (
    <span class="block text-sm text-white/80 mt-1">
      {t('rooms.from')} {price}€ {t('rooms.night')}
    </span>
    )}
  </div>

  <form
    name="booking-room"
    x-data={`{
      checkin: '',
      checkout: '',
      adults: '2',
      children: '0',
      showWarning: false,
      handleSubmit(e) {
        const totalGuests = parseInt(this.adults) + parseInt(this.children);
        if (totalGuests > 4) {
          e.preventDefault();
          this.showWarning = true;
          return;
        }
        this.showWarning = false;
        e.preventDefault();
        const url = new URL('https://beds24.com/booking2.php');
        url.searchParams.set('propid', '328935');
        url.searchParams.set('lang', '${lang}');
        if (this.checkin) url.searchParams.set('checkin', this.checkin);
        if (this.checkout) url.searchParams.set('checkout', this.checkout);
        url.searchParams.set('numadult', this.adults);
        url.searchParams.set('numchild', this.children);
        window.open(url.toString(), '_blank');
      }
    }`}
    x-on:submit="handleSubmit($event)"
    class="grid grid-cols-2 gap-5"
  >
    <!-- Check-in -->
    <div>
      <label class="text-sm text-white mb-1 block">{t('booking.checkin')}</label>
      <input
        type="date"
        name="checkin"
        required
        x-model="checkin"
        class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
      />
    </div>

    <!-- Check-out -->
    <div>
      <label class="text-sm text-white mb-1 block">{t('booking.checkout')}</label>
      <input
        type="date"
        name="checkout"
        required
        x-model="checkout"
        class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
      />
    </div>

    <!-- Adults -->
    <div>
      <label class="text-sm text-white mb-1 block">{t('booking.adults')}</label>
      <select
        name="adults"
        x-model="adults"
        class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
      >
        <option value="1">{d.adult1}</option>
        <option value="2">2 {d.adult}</option>
        <option value="3">3 {d.adult}</option>
        <option value="4">4 {d.adult}</option>
        <option value="5">5 {d.adult}</option>
        <option value="6">6 {d.adult}</option>
      </select>
    </div>

    <!-- Children -->
    <div>
      <label class="text-sm text-white mb-1 block">{t('booking.children')}</label>
      <select
        name="children"
        x-model="children"
        class="w-full px-4 py-3 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary"
      >
        <option value="0">{d.child0}</option>
        <option value="1">{d.child1}</option>
        <option value="2">2 {d.child}</option>
        <option value="3">3 {d.child}</option>
      </select>
    </div>

    <!-- Warning block for > 4 guests in Hostalet -->
    <div x-show="showWarning && (parseInt(adults) + parseInt(children) > 4)" x-transition class="col-span-2 p-4 bg-amber-500/10 border border-amber-500/30 text-amber-200 text-sm rounded-lg flex items-start gap-3">
      <Icon name="bi:exclamation-triangle" class="w-5 h-5 flex-shrink-0 text-amber-500 mt-0.5" />
      <div>
        {lang === 'es' && "La capacidad máxima por habitación es de 4 personas. Para grupos de 5 o más personas, por favor realiza una segunda reserva o contáctanos directamente para coordinar tu estancia."}
        {lang === 'ca' && "La capacitat màxima per habitació és de 4 persones. Per a grups de 5 o més persones, si us plau realitza una segona reserva o contacta'ns directament per coordinar la teva estada."}
        {lang === 'en' && "The maximum capacity per room is 4 people. For groups of 5 or more guests, please make a second booking or contact us directly to arrange your stay."}
        {lang === 'fr' && "La capacité maximale par chambre est de 4 personnes. Pour les groupes de 5 personnes ou plus, veuillez effectuer une deuxième réservation ou nous contacter directement pour organiser votre séjour."}
      </div>
    </div>

    <!-- Submit -->
    <div class="col-span-2 mt-2">
      <button
        type="submit"
        class="w-full flex items-center gap-2 justify-center bg-green-700 text-white px-8 py-4 hover:bg-green-800 transition text-lg"
      >
        <Icon name="bi:journal-check" class="text-lg" />
        {lang === 'es' && "Reservar en Beds24"}
        {lang === 'ca' && "Reservar a Beds24"}
        {lang === 'en' && "Book on Beds24"}
        {lang === 'fr' && "Réserver sur Beds24"}
      </button>
    </div>

    <p class="text-white/60 text-sm mt-2 text-center col-span-2">
      {lang === 'es' && "Confirmación en tiempo real. Serás redirigido a nuestro motor seguro."}
      {lang === 'ca' && "Confirmació en temps real. Seràs redirigit al nostre motor segur."}
      {lang === 'en' && "Real-time confirmation. You will be redirected to our secure booking engine."}
      {lang === 'fr' && "Confirmation en temps réel. Vous serez redirigé vers notre moteur sécurisé."}
    </p>
  </form>
</div>

<script is:inline>
  (function() {
    const params = new URLSearchParams(window.location.search);
    const form = document.querySelector('form[name="booking-room"]');
    if (!form) return;
    const checkin = params.get('checkin');
    const checkout = params.get('checkout');
    const adults = params.get('adults');
    const children = params.get('children');
    if (checkin && form.checkin) form.checkin.value = checkin;
    if (checkout && form.checkout) form.checkout.value = checkout;
    if (adults && form.adults) form.adults.value = adults;
    if (children && form.children) form.children.value = children;
  })();
</script>
