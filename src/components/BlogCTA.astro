---
import { Icon } from "astro-icon/components";

export interface Props {
  title?: string;
  text?: string;
  buttonText?: string;
  link?: string;
}

const lang = (Astro.currentLocale || 'es') as keyof typeof import('../i18n/ui').ui;

const bookingLinks = {
  es: '/reservas/',
  ca: '/ca/reserves/',
  en: '/en/booking/',
  fr: '/fr/reservations/'
};
const defaultLink = bookingLinks[lang] || bookingLinks.es;

const {
  title = "¿Planeas visitar Tossa de Mar?",
  text = "Alójate en el corazón de Vila Vella con Hostalet de Tossa o El Bergantí. Descubre la auténtica Costa Brava con nosotros.",
  buttonText = "Ver Alojamientos y Reservar",
  link = defaultLink
} = Astro.props;
---
<div class="my-10 p-8 bg-skin-light rounded-tl-3xl rounded-br-3xl shadow-sm border border-primary/20 text-center flex flex-col items-center">
  <Icon name="bi:house-heart" class="text-4xl text-primary mb-4" />
  <h3 class="font-heading text-2xl text-primary-dark mb-2">{title}</h3>
  <p class="text-gray-700 mb-6 max-w-lg mx-auto">
    {text}
  </p>
  <a 
    href={link} 
    class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-primary text-white px-8 py-4 hover:bg-primary-dark transition rounded-sm text-lg font-bold uppercase tracking-wider shadow-md hover:shadow-xl transform hover:-translate-y-1"
    style="color: white !important;"
  >
    <Icon name="bi:calendar-check" class="flex-shrink-0 w-6 h-6" />
    <span class="text-center text-white">{buttonText}</span>
  </a>
</div>
