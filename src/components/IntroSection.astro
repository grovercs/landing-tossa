---
import IntroFeatureItem, { type IntroFeature } from "./IntroFeatureItem.astro";

export interface Props {
  id?: string;
  title: string;
  paragraphs: string[];
  features: IntroFeature[];
  image: string;
  imageAlt?: string;
  decorColor?: string; // background square behind image — default: bg-primary
}

const {
  id = "intro",
  title,
  paragraphs = [],
  features = [],
  image,
  imageAlt = "intro section image",
  decorColor = "bg-primary"
} = Astro.props;
---

<section id={id} class="py-20 bg-white overflow-x-hidden">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- IMAGE -->
      <div class="relative">
        <div class={`absolute -bottom-8 -right-8 w-48 h-48 ${decorColor}`}></div>

        <img
          src={image}
          alt={imageAlt}
          class="relative w-full h-auto rounded-tl-3xl object-cover"
        />
      </div>

      <!-- CONTENT -->
      <div>
        <h2 class="font-heading text-4xl lg:text-5xl text-primary-dark mb-5">
          {title}
        </h2>

        <div class="post-content mb-6">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="grid sm:grid-cols-2 gap-4 text-gray-700">
          {features.map((item) => (
            <IntroFeatureItem item={item} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
