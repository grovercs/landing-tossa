<!-- Exit Intent Popup: Reserva Directa -->
<div
  x-data="{
    show: false,
    dismissed: false,
    init() {
      const cookie = document.cookie.includes('exitPopupDismissed=1');
      if (cookie) return;

      // Exit intent: detectar cuando el mouse sale por la parte superior
      document.addEventListener('mouseout', (e) => {
        if (e.clientY < 10 && !this.dismissed && !this.show) {
          this.show = true;
        }
      });

      // También mostrar tras 45 segundos si no ha interactuado
      setTimeout(() => {
        if (!this.dismissed && !this.show) {
          this.show = true;
        }
      }, 45000);
    },
    close() {
      this.show = false;
      this.dismissed = true;
      document.cookie = 'exitPopupDismissed=1; max-age=86400; path=/'; // 24h
    }
  }"
  x-show="show"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0 scale-95"
  x-transition:enter-end="opacity-100 scale-100"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100 scale-100"
  x-transition:leave-end="opacity-0 scale-95"
  class="fixed inset-0 z-[60] flex items-center justify-center p-4"
  style="display: none;"
>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="close()"></div>

  <!-- Modal -->
  <div class="relative w-full max-w-lg bg-white rounded-tl-3xl rounded-br-3xl shadow-2xl overflow-hidden">
    <!-- Header image -->
    <div class="relative h-40 bg-primary">
      <img
        src="/images/tossa-de-mar-costa-brava-1.webp"
        alt="Tossa de Mar"
        class="absolute inset-0 w-full h-full object-cover opacity-40"
        loading="lazy"
        decoding="async"
      />
      <button
        @click="close()"
        class="absolute top-4 right-4 text-white/80 hover:text-white transition"
        aria-label="Cerrar"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="absolute bottom-4 left-6 text-white">
        <span class="inline-block bg-white/20 backdrop-blur text-xs font-medium px-3 py-1 rounded-full">
          Reserva Directa
        </span>
      </div>
    </div>

    <!-- Content -->
    <div class="p-6 md:p-8 text-center">
      <h3 class="font-heading text-2xl md:text-3xl text-primary-dark mb-3">
        Mejor Precio Garantizado
      </h3>

      <p class="text-gray-600 mb-6 leading-relaxed">
        Reserva directamente con nosotros y obtén <strong class="text-primary-dark">Late Check-out gratis</strong>
        y <strong class="text-primary-dark">un detalle de bienvenida</strong>.
        Sin comisiones, sin intermediarios. Solo tú y la auténtica Costa Brava.
      </p>

      <!-- Benefits -->
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        <span class="flex items-center gap-1 text-sm text-gray-700 bg-gray-50 px-3 py-1.5 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Late Check-out
        </span>
        <span class="flex items-center gap-1 text-sm text-gray-700 bg-gray-50 px-3 py-1.5 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Sin comisiones
        </span>
        <span class="flex items-center gap-1 text-sm text-gray-700 bg-gray-50 px-3 py-1.5 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Atención directa
        </span>
      </div>

      <!-- CTA -->
      <a
        href="/reservas"
        @click="close()"
        class="inline-flex items-center justify-center gap-2 w-full bg-primary text-white font-medium px-8 py-4 rounded-tl-2xl rounded-br-2xl hover:bg-primary-dark transition shadow-lg hover:shadow-xl"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Ver Disponibilidad y Precios
      </a>

      <p class="text-xs text-gray-400 mt-4">
        Oferta exclusiva solo en nuestra web. No disponible en Booking ni Expedia.
      </p>
    </div>
  </div>
</div>
