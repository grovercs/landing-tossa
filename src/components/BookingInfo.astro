---
import { Icon } from "astro-icon/components";

export interface BookingInfoItem {
  icon: string;     // ex: "bi:clock"
  text: string;
}

export interface Props {
  title: string;
  items: BookingInfoItem[];
}

const { title, items } = Astro.props;
---

<div class="bg-skin-light p-8 rounded-tl-3xl shadow-lg">
  <h2 class="font-heading text-2xl text-primary-dark mb-4">
    {title}
  </h2>

  <ul class="space-y-4 text-gray-600">
    {items.map((item) => (
      <li class="flex items-center gap-3">
        <Icon name={item.icon} class="text-primary text-xl" />
        <span>{item.text}</span>
      </li>
    ))}
  </ul>
</div>
