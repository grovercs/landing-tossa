---
import MainLayout from "@src/layouts/MainLayout.astro";
import BookingFormPage from "@src/components/BookingFormPage.astro";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import BookingInfo from "@src/components/BookingInfo.astro";

// ======================================
// STATIC PATHS
// ======================================
export async function getStaticPaths() {
  const rooms = await getCollection("rooms", ({ id }) => id.startsWith("es/"));
  return rooms.map((room) => ({
    params: { slug: room.id.replace("es/", "").replace(/\.mdx$/, "") },
  }));
}

// ======================================
// GET ROOM DATA
// ======================================
const { slug } = Astro.params;
const allRoomsForEntry = await getCollection("rooms", ({ id }) => id.startsWith("es/"));
const room = allRoomsForEntry.find(r => r.id.replace("es/", "").replace(/\.mdx$/, "") === slug);

if (!room) {
  throw new Error(`Room not found: ${slug}`);
}

const { Content } = await render(room);
const { data } = room;

// Rating helpers
const fullStars = Math.floor(data.rating);
const hasHalfStar = data.rating % 1 !== 0;

// Images
const featured = data.featuredImage;
const gallery = data.gallery ?? [];
---
<MainLayout
  title={data.title}
  description={`${data.title} - Alojamiento en Tossa de Mar. ${data.label}. Reserva directa.`}
  image={data.featuredImage}
  schema={{
    "@context": "https://schema.org",
    "@type": "Hotel",
    "name": data.title,
    "image": `https://landing-tossa.netlify.app${data.featuredImage}`,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Tossa de Mar",
      "addressRegion": "Girona",
      "addressCountry": "ES"
    },
    "aggregateRating": data.rating && data.ratingCount ? {
      "@type": "AggregateRating",
      "ratingValue": String(data.rating),
      "reviewCount": data.ratingCount
    } : undefined,
    "amenityFeature": data.amenities?.map((a) => ({
      "@type": "LocationFeatureSpecification",
      "name": a.label,
      "value": true
    }))
  }}
>
  <div id="rooms" class="py-8 sm:py-12 bg-white overflow-x-hidden">
    <div class="max-w-7xl mx-auto px-4">

      <!-- Heading -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-6">
        <div class="flex flex-col">
          <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl text-primary-dark mb-2">
            {data.title}
          </h1>

          <!-- Rating -->
          <div class="flex items-center gap-2">
            <span class="text-gray-600">{data.rating}</span>

            {Array.from({ length: fullStars }).map(() => (
              <Icon name="bi:star-fill" class="text-lg text-yellow-500" />
            ))}

            {hasHalfStar && (
              <Icon name="bi:star-half" class="text-lg text-yellow-500" />
            )}

            <span class="text-gray-600">
              ({data.ratingCount} Reseñas)
            </span>
          </div>
        </div>

        {(data.price && data.price > 0) && (
        <div class="relative">
          <span class="text-heading text-lg md:text-xl font-semibold text-green-600 bg-primary/10 rounded-tl-2xl rounded-br-2xl py-3 px-6">
            Desde {data.price}€/noche
          </span>
        </div>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- MAIN -->
        <div class="relative md:col-span-2">

          <!-- Gallery -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-1 sm:gap-2 mb-8">
            <!-- Featured -->
            <div class="relative aspect-4/3 bg-gray-100 md:aspect-square overflow-hidden group rounded-tl-3xl">
              <a href={featured} class="glightbox">
                <img
                  src={featured}
                  alt={data.title}
                  class="absolute inset-0 h-full object-cover group-hover:scale-110 transition-all duration-500"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </div>

            <!-- Additional -->
            <div class="grid grid-cols-4 md:grid-cols-2 gap-1 sm:gap-2">
              {gallery.map((img, i) => (
                <div
                  class={`relative overflow-hidden max-md:aspect-square bg-gray-100 group ${
                    i === gallery.length - 1 ? "rounded-br-3xl" : ""
                  }`}
                >
                  <a href={img} class="glightbox">
                    <img
                      src={img}
                      alt={`gallery-${i}`}
                      class="absolute inset-0 h-full object-cover group-hover:scale-110 transition-all duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              ))}
            </div>
          </div>

          <!-- Amenities -->
          <div class="relative mb-8">
            <h2 class="font-heading text-xl md:text-2xl text-primary-dark mb-2">
              Servicios Ofrecidos
            </h2>

            <div class="grid grid-cols-2 md:grid-cols-3 sm:p-6 max-sm:text-sm sm:bg-skin-light sm:rounded-tl-2xl rounded-br-2xl sm:shadow-sm">
              {data.amenities.map((item) => (
                <span class="flex items-center gap-1 py-2 border-b border-dashed border-accent">
                  <Icon name={item.icon} /> {item.label}
                </span>
              ))}
            </div>
          </div>

          <!-- Content -->
          <div class="post-content mb-6">
            <Content />
          </div>
        </div>

        <!-- SIDEBAR -->
        <div class="relative">

          <!-- Booking Form -->
          <BookingFormPage roomTitle={data.title} price={data.price} />

          <!-- Info -->
          <BookingInfo
          title="Información de Reserva"
          items={[
            { icon: "bi:clock", text: "Check-in a partir de las 14:00 h" },
            { icon: "bi:clock-history", text: "Check-out antes de las 12:00 h" },
            { icon: "bi:shield-check", text: "Cancelación gratuita hasta 24 horas antes de la llegada" },
            { icon: "bi:cup-hot", text: "Desayuno incluido en todos los tipos de habitación" },
            { icon: "bi:wifi", text: "Wi-Fi de alta velocidad gratuito en cada habitación" },
            { icon: "bi:cash-stack", text: "Múltiples opciones de pago disponibles" },
            { icon: "bi:people", text: "Dos niños mayores de 10 años deben reservar su propia habitación." },
          ]}
        />
        </div>
      </div>
    </div>
  </div>
</MainLayout>