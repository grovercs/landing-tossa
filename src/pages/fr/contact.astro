---
import ContactPage from "@src/components/ContactPage.astro";
import HeadingPage from "@src/components/HeadingPage.astro";
import MainLayout from "@src/layouts/MainLayout.astro";
---

<MainLayout title="Contact - Hostalet de Tossa & El Bergantí" description="Contactez nos hébergements à Tossa de Mar.">
    <HeadingPage
        title="Contact"
        subtitle="Avez-vous des questions sur votre séjour ou avez-vous besoin d'aide pour votre réservation ? Notre équipe est à votre disposition."
        background="/images/tossa-de-marcha-iglesia-de-st-vincent.png"
        />
    <ContactPage
    heading="Informations"
    items={[
        {
        icon: "bi:geo-alt",
        title: "Emplacement",
        text: "Tossa de Mar\nCosta Brava, Gérone"
        },
        {
        icon: "bi:telephone",
        title: "Téléphones",
        text: "L'Hostalet : +34 634 39 83 57\nEl Bergantí : +34 682 04 79 50"
        },
        {
        icon: "bi:envelope",
        title: "Email",
        text: "reservas@hostalhostalet.com\nreservas@elberganti-tossa.com"
        },
        {
        icon: "bi:clock",
        title: "Horaires",
        text: "Lundi – Dimanche : 08h00 – 22h00"
        }
    ]}
    />
</MainLayout>