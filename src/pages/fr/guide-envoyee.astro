---
import Layout from "../../layouts/MainLayout.astro";

const title = "Guide envoyée — El Hostalet de Tossa";
const description = "Merci de vous être abonné. Votre guide secret de Tossa de Mar est en route.";

const copy = {
  headline: "Merci de vous être abonné !",
  sub: "Nous vous avons envoyé un email avec le lien pour télécharger votre guide exclusif.",
  cta: "Aller au blog de Tossa",
  note: "Si vous ne le voyez pas dans quelques minutes, vérifiez votre dossier spam ou courrier indésirable.",
  redirect: "Nous vous redirigeons vers le blog dans",
  seconds: "secondes",
};
---

<Layout title={title} description={description} robots="noindex, follow">
  <section class="min-h-[70vh] flex items-center justify-center px-4 py-16 bg-primary/5">
    <div class="max-w-xl w-full text-center">
      <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="font-heading text-3xl sm:text-4xl text-primary-dark mb-4">
        {copy.headline}
      </h1>

      <p class="text-gray-600 text-lg mb-2">
        {copy.sub}
      </p>

      <p class="text-sm text-gray-400 mb-8">
        {copy.note}
      </p>

      <a
        href="/fr/blog/"
        class="inline-block bg-primary hover:bg-primary-dark text-white font-medium px-8 py-3 rounded-lg transition-colors"
      >
        {copy.cta}
      </a>

      <p class="text-sm text-gray-400 mt-8" id="redirect-countdown">
        {copy.redirect} <span class="font-semibold text-primary-dark">5</span> {copy.seconds}...
      </p>
    </div>
  </section>

  <script>
    let seconds = 5;
    const span = document.querySelector('#redirect-countdown span');
    const interval = setInterval(() => {
      seconds--;
      if (span) span.textContent = seconds;
      if (seconds <= 0) {
        clearInterval(interval);
        window.location.href = '/fr/blog/';
      }
    }, 1000);
  </script>
</Layout>
