---
import ContactPage from "@src/components/ContactPage.astro";
import HeadingPage from "@src/components/HeadingPage.astro";
import MainLayout from "@src/layouts/MainLayout.astro";
---

<MainLayout title="Contacto - Hostalet de Tossa & El Bergantí" description="Ponte en contacto con nuestros alojamientos en Tossa de Mar.">
    <HeadingPage
        title="Contacto"
        subtitle="¿Tienes alguna duda sobre tu estancia o necesitas ayuda con tu reserva? Nuestro equipo está a tu disposición."
        background="/images/tossa-de-marcha-iglesia-de-st-vincent.png"
        />
    <ContactPage
    heading="Información"
    items={[
        {
        icon: "bi:geo-alt",
        title: "Ubicación",
        text: "Tossa de Mar\nCosta Brava, Girona"
        },
        {
        icon: "bi:telephone",
        title: "Teléfonos",
        text: "Hostalet: +34 972 34 00 00\nEl Bergantí: +34 972 34 04 22"
        },
        {
        icon: "bi:envelope",
        title: "Email",
        text: "reservas@hostalhostalet.com\nreservas@elberganti-tossa.com"
        },
        {
        icon: "bi:clock",
        title: "Horarios",
        text: "Lunes – Domingo: 08.00 – 22.00"
        }
    ]}
    />
</MainLayout>