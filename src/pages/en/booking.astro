---
import BookingPage from "@src/components/BookingPage.astro";
import HeadingPage from "@src/components/HeadingPage.astro";
import NotFoundSection from "@src/components/NotFoundSection.astro";
import MainLayout from "@src/layouts/MainLayout.astro";
---

<MainLayout title="Book your Accommodation in Tossa de Mar - Costa Brava" description="Secure your perfect stay at El Bergantí or Hostalet de Tossa by completing the booking form.">
    <HeadingPage
        title="Book Accommodation"
        subtitle="Secure your perfect stay in the heart of the Costa Brava by completing the form below."
        background="/images/vista-de-la-iglesia-hostal-hostalet-tossa.avif"
        />
    <BookingPage 
        infoTitle="Booking Information"
        infoItems={[
            { icon: "bi:clock", text: "Check-in time starts from 14:00 PM" },
            { icon: "bi:clock-history", text: "Check-out time before 12:00 PM" },
            { icon: "bi:shield-check", text: "Free cancellation up to 24 hours before arrival" },
            { icon: "bi:cup-hot", text: "Own restaurants in the accommodations" },
            { icon: "bi:wifi", text: "Free high-speed Wi-Fi" },
        ]}
        helpTitle="Need Help?"
        helpDescription="Our reception team is ready to help you with any special request."
        helpItems={[
            { icon: "bi:telephone", text: "El Bergantí: +34 972 34 04 22" },
            { icon: "bi:telephone", text: "Hostalet: +34 972 34 00 00" },
        ]}
        formFields={[
            { label: "Full Name", type: "text", name: "fullName" },
            { label: "Email Address", type: "email", name: "email" },
            { label: "Phone Number", type: "text", name: "phone" },
            {
                label: "Accommodation",
                type: "select",
                name: "roomType",
                options: [
                "El Bergantí - Double Room",
                "Hostalet de Tossa - Double Room",
                "Hostalet de Tossa - Triple Room"
                ]
            },
            { label: "Check-in Date", type: "date", name: "checkin" },
            { label: "Check-out Date", type: "date", name: "checkout" },
            {
                label: "Adults",
                type: "select",
                name: "adults",
                options: ["1 Adult", "2 Adults", "3 Adults", "4 Adults"]
            },
            {
                label: "Children",
                type: "select",
                name: "children",
                options: ["0 Children", "1 Child", "2 Children", "3 Children"]
            },
            {
                label: "Special Requests",
                type: "textarea",
                name: "requests",
                span: 2
            }
        ]}
        submitText="Confirm Booking"
    />
</MainLayout>
