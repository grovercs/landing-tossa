---
import ContactPage from "@src/components/ContactPage.astro";
import HeadingPage from "@src/components/HeadingPage.astro";
import MainLayout from "@src/layouts/MainLayout.astro";
---

<MainLayout title="Contact - Hostalet de Tossa & El Bergantí" description="Get in touch with our accommodations in Tossa de Mar.">
    <HeadingPage
        title="Contact"
        subtitle="Do you have any questions about your stay or need help with your booking? Our team is at your disposal."
        background="/images/tossa-de-marcha-iglesia-de-st-vincent.png"
        />
    <ContactPage
    heading="Information"
    items={[
        {
        icon: "bi:geo-alt",
        title: "Location",
        text: "Tossa de Mar\nCosta Brava, Girona"
        },
        {
        icon: "bi:telephone",
        title: "Phones",
        text: "Hostalet: +34 634 39 83 57\nEl Bergantí: +34 682 04 79 50"
        },
        {
        icon: "bi:envelope",
        title: "Email",
        text: "reservas@hostalhostalet.com\nreservas@elberganti-tossa.com"
        },
        {
        icon: "bi:clock",
        title: "Opening Hours",
        text: "Monday – Sunday: 08:00 – 22:00"
        }
    ]}
    />
</MainLayout>