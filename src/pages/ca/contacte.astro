---
import ContactPage from "@src/components/ContactPage.astro";
import HeadingPage from "@src/components/HeadingPage.astro";
import MainLayout from "@src/layouts/MainLayout.astro";
---

<MainLayout title="Contacte - El Bergantí & Hostalet de Tossa" description="Posa't en contacte amb els nostres allotjaments a Tossa de Mar.">
    <HeadingPage
        title="Contacte"
        subtitle="Tens algun dubte sobre la teva estada o necessites ajuda amb la teva reserva? El nostre equip està a la teva disposició."
        background="/images/tossa-de-marcha-iglesia-de-st-vincent.png"
        />
    <ContactPage
    heading="Informació"
    items={[
        {
        icon: "bi:geo-alt",
        title: "Ubicació",
        text: "Tossa de Mar\nCosta Brava, Girona"
        },
        {
        icon: "bi:telephone",
        title: "Telèfons",
        text: "Hostalet: +34 972 34 00 00\nEl Bergantí: +34 972 34 04 22"
        },
        {
        icon: "bi:envelope",
        title: "Email",
        text: "reservas@hostalhostalet.com\nreservas@elberganti-tossa.com"
        },
        {
        icon: "bi:clock",
        title: "Horaris",
        text: "Dilluns – Diumenge: 08.00 – 22.00"
        }
    ]}
    />
</MainLayout>