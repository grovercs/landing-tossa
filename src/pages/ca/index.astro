---
import AboutSection from "@src/components/AboutSection.astro";
import AwardsSection from "@src/components/AwardsSection.astro";
import BlogCard from "@src/components/BlogCard.astro";
import CloudbedsBooking from "@src/components/CloudbedsBooking.astro";
import DirectBookingBanner from "@src/components/DirectBookingBanner.astro";
import FacilitiesSection from "@src/components/FacilitiesSection.astro";
import GallerySection from "@src/components/GallerySection.astro";
import GuestReviews from "@src/components/GuestReviews.astro";
import HeroSection from "@src/components/HeroSection.astro";
import RestaurantSection from "@src/components/RestaurantSection.astro";
import RoomsSection from "@src/components/RoomsSection.astro";
import TourismPresenceSection from "@src/components/TourismPresenceSection.astro";
import MainLayout from "@src/layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "@src/i18n/utils";

const lang = "ca";
const t = useTranslations(lang);

const allPosts = await getCollection("blog", ({ id }) => id.startsWith("ca/"));
const latestPosts = allPosts
  .sort((a, b) => {
    const dateA = new Date(a.data.date);
    const dateB = new Date(b.data.date);
    return dateB.valueOf() - dateA.valueOf();
  })
  .slice(0, 3);

const blogBase = "/ca/blogs";
---

<MainLayout title="Hostalet de Tossa & El Bergantí - Costa Brava" description="Dos allotjaments amb encant al centre de Tossa de Mar. Tria entre l'Hostalet de Tossa i El Bergantí amb reserva directa.">
  <HeroSection />
  <CloudbedsBooking />
  <DirectBookingBanner />
  <AboutSection
    title="Allotjament al centre de Tossa de Mar"
    image="/images/tossa-de-mar-costa-brava-1.webp"
    paragraphs={[
      "Gaudeix de la Costa Brava amb nosaltres. T'oferim dues opcions amb encant al cor de Tossa de Mar, ideals per explorar la Vila Vella, relaxar-te a la platja i viure l'essència de la Mediterrània.",
      "Tant a l'Hostalet de Tossa com a El Bergantí, trobaràs un tracte familiar i directe, garantint la millor experiència sense intermediaris."
    ]}
    list={[
      {
        icon: "bi:geo-alt",
        title: "Ubicació Privilegiada",
        description: "A pocs minuts de la platja i en ple nucli antic"
      },
      {
        icon: "bi:shop",
        title: "Restaurants Propis",
        description: "Cuina mediterrània de qualitat al teu propi allotjament"
      }
    ]}
  />
  <FacilitiesSection
    title="Per què triar-nos"
    subtitle="Els nostres allotjaments estan pensats per oferir-te comoditat, bona ubicació i el tracte càlid que caracteritza la Costa Brava."
    imageDecor="/img/lamp.png"
    facilities={[
      {
        icon: "bi:wifi",
        title: "Wi-Fi Gratuït",
        description: "Connexió a internet disponible"
      },
      {
        icon: "bi:shop",
        title: "Restaurant",
        description: "Cuina mediterrània de qualitat"
      },
      {
        icon: "bi:brightness-high",
        title: "Terrasses Acollidores",
        description: "Espais tranquils per esmorzar o sopar"
      },
      {
        icon: "bi:geo",
        title: "Cèntric",
        description: "Explora Tossa de Mar a peu"
      },
      {
        icon: "bi:hand-thumbs-up",
        title: "Reserva Directa",
        description: "Millor preu garantit sense intermediaris"
      },
      {
        icon: "bi:chat-left",
        title: "Atenció Propera",
        description: "Tracte directe amb recepció"
      }
    ]}
  />

  <RoomsSection
    title="Els Nostres Allotjaments"
    description="Descobreix les nostres opcions per a una estada perfecta a Tossa de Mar."
    maxPosts={6}
  />

  <GuestReviews lang={lang} />
  <RestaurantSection 
    title="Gastronomia a Tossa de Mar"
    content={[
      "Descobreix la nostra proposta gastronòmica a El Bergantí, especialitzat en tapes, arrossos i cuina mediterrània elaborada amb producte local.",
      "O relaxa't a l'evocadora terrassa de l'Hostalet, el lloc ideal per a un esmorzar tranquil o gaudir de l'ambient del nucli antic al costat de l'església."
    ]}
    stats={[
      { value: "100%", label: "Producte Local" },
      { value: "1789", label: "Any Hostalet" },
      { value: "10+", label: "Especialitats" }
    ]}
    slides={[
      { src: "/images/elberganti-restaurante-tapas-tossa-mar.webp", title: "Restaurant El Bergantí" },
      { src: "/images/terraza-hostal-hostalet-tossa.avif", title: "Terrassa Hostalet" }
    ]}
  />
  <GallerySection
    title="Els Nostres Allotjaments"
    subtitle="Explora l'Hostalet de Tossa i El Bergantí."
    images={[
      { src: "/images/fachada-hostalet.avif", alt: "Hostalet Exterior" },
      { src: "/images/habitacion-doble-hostal-hostalet-tossa.avif", alt: "Habitació Hostalet" },
      { src: "/images/terraza-hostal-hostalet-tossa.avif", alt: "Terrassa Hostalet" },
      { src: "/images/hotel-tossa-de-mar-restaurante.webp", alt: "El Bergantí Exterior" },
      { src: "/images/habitacion-doble-berganti-tossa.webp", alt: "Habitació Bergantí" },
      { src: "/images/elberganti-restaurante-tapas-tossa-mar.webp", alt: "Restaurant Bergantí" },
    ]}
  />
  <TourismPresenceSection
    badge="Presència Oficial"
    title="Ens trobaràs a..."
    subtitle="Col·laborem amb les principals plataformes i organismes turístics de la Costa Brava i Catalunya per donar-te la millor visibilitat i experiència."
    note="Reserva directament a la nostra web i obtén el millor preu garantit."
  />

  <!-- Blog Preview Section -->
  {latestPosts.length > 0 && (
    <section class="py-20 bg-skin-light overflow-x-hidden">
      <div class="max-w-7xl mx-auto px-4">
        <div class="max-w-2xl mx-auto mb-12 text-center">
          <h2 class="font-heading text-4xl lg:text-5xl text-primary-dark mb-4">
            {t('home.blogTitle')}
          </h2>
          <p class="text-gray-700 text-lg leading-relaxed">
            {t('home.blogDescription')}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {latestPosts.map((post) => (
            <BlogCard post={post} lang={lang} />
          ))}
        </div>

        <div class="mt-12 text-center">
          <a
            href={blogBase}
            class="inline-flex items-center gap-2 justify-center bg-primary text-white px-6 py-3 hover:bg-primary-dark transition"
          >
            {t('home.blogCta')}
          </a>
        </div>
      </div>
    </section>
  )}
</MainLayout>