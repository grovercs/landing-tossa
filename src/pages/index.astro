---
import AboutSection from "@src/components/AboutSection.astro";
import AwardsSection from "@src/components/AwardsSection.astro";
import CloudbedsBooking from "@src/components/CloudbedsBooking.astro";
import DirectBookingBanner from "@src/components/DirectBookingBanner.astro";
import FacilitiesSection from "@src/components/FacilitiesSection.astro";
import GallerySection from "@src/components/GallerySection.astro";
import GuestReviews from "@src/components/GuestReviews.astro";
import HeroSection from "@src/components/HeroSection.astro";
import BlogCard from "@src/components/BlogCard.astro";
import RestaurantSection from "@src/components/RestaurantSection.astro";
import RoomsSection from "@src/components/RoomsSection.astro";
import MainLayout from "@src/layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "@src/i18n/utils";

const lang = (Astro.currentLocale || 'es') as keyof typeof import('../i18n/ui').ui;
const t = useTranslations(lang);

// Fetch latest 3 blog posts for the current language
const allPosts = await getCollection("blog", ({ id }) => id.startsWith(`${lang}/`));
const latestPosts = allPosts
  .sort((a, b) => {
    const dateA = new Date(a.data.date);
    const dateB = new Date(b.data.date);
    return dateB.valueOf() - dateA.valueOf();
  })
  .slice(0, 3);

const blogBase = lang === 'es' ? '/blogs' : `/${lang}/blogs`;
---

<MainLayout
  title={`${t('hero.title')} - Costa Brava`}
  description={t('hero.subtitle')}
>
  <HeroSection />
  <CloudbedsBooking />
  <DirectBookingBanner />
  <AboutSection
    title="Alojamiento en el centro de Tossa de Mar"
    image="/images/tossa-de-mar-costa-brava-1.webp"
    paragraphs={[
      "Disfruta de la Costa Brava con nosotros. Te ofrecemos dos opciones con encanto en pleno centro de Tossa de Mar, ideales para explorar la Vila Vella, relajarte en la playa y vivir la esencia del Mediterráneo.",
      "Tanto en el Hostalet de Tossa como en El Bergantí, encontrarás un trato familiar y directo, garantizando la mejor experiencia sin intermediarios."
    ]}
    list={[
      {
        icon: "bi:geo-alt",
        title: "Ubicación Privilegiada",
        description: "A pocos minutos de la playa y en pleno casco antiguo"
      },
      {
        icon: "bi:shop",
        title: "Restaurantes Propios",
        description: "Cocina mediterránea de calidad en tu propio alojamiento"
      }
    ]}
  />
  <FacilitiesSection
    title="Por qué elegirnos"
    subtitle="Nuestros alojamientos están pensados para ofrecerte comodidad, buena ubicación y el trato cálido que caracteriza a la Costa Brava."
    imageDecor="/img/lamp.png"
    facilities={[
      {
        icon: "bi:wifi",
        title: "Wi-Fi Gratuito",
        description: "Conexión a internet disponible"
      },
      {
        icon: "bi:shop",
        title: "Restaurante",
        description: "Cocina mediterránea de calidad"
      },
      {
        icon: "bi:brightness-high",
        title: "Terrazas Acogedoras",
        description: "Espacios tranquilos para desayunar o cenar"
      },
      {
        icon: "bi:geo",
        title: "Céntrico",
        description: "Explora Tossa de Mar a pie"
      },
      {
        icon: "bi:hand-thumbs-up",
        title: "Reserva Directa",
        description: "Mejor precio garantizado sin intermediarios"
      },
      {
        icon: "bi:chat-left",
        title: "Atención Cercana",
        description: "Trato directo con recepción"
      }
    ]}
  />

  <RoomsSection
    title="Nuestros Alojamientos"
    description="Descubre nuestras opciones para una estancia perfecta en Tossa de Mar."
    maxPosts={6}
  />

  <GuestReviews lang={lang} />

  <RestaurantSection />
  <GallerySection
    title="Nuestros Alojamientos"
    subtitle="Explora el Hostalet de Tossa y El Bergantí."
    images={[
      { src: "/images/fachada-hostalet.avif", alt: "Hostalet Exterior" },
      { src: "/images/habitacion-doble-hostal-hostalet-tossa.avif", alt: "Habitación Hostalet" },
      { src: "/images/terraza-hostal-hostalet-tossa.avif", alt: "Terraza Hostalet" },
      { src: "/images/hotel-tossa-de-mar-restaurante.webp", alt: "El Bergantí Exterior" },
      { src: "/images/habitacion-doble-berganti-tossa.webp", alt: "Habitación Bergantí" },
      { src: "/images/elberganti-restaurante-tapas-tossa-mar.webp", alt: "Restaurante Bergantí" },
    ]}
  />

  <!-- Blog Preview Section -->
  {latestPosts.length > 0 && (
    <section class="py-20 bg-skin-light overflow-x-hidden">
      <div class="max-w-7xl mx-auto px-4">
        <div class="max-w-2xl mx-auto mb-12 text-center">
          <h2 class="font-heading text-4xl lg:text-5xl text-primary-dark mb-4">
            {t('home.blogTitle')}
          </h2>
          <p class="text-gray-700 text-lg leading-relaxed">
            {t('home.blogDescription')}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {latestPosts.map((post) => (
            <BlogCard post={post} lang={lang} />
          ))}
        </div>

        <div class="mt-12 text-center">
          <a
            href={blogBase}
            class="inline-flex items-center gap-2 justify-center bg-primary text-white px-6 py-3 hover:bg-primary-dark transition"
          >
            {t('home.blogCta')}
          </a>
        </div>
      </div>
    </section>
  )}
</MainLayout>
